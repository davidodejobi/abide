<?xml version="1.0" encoding="utf-8"?>
<!-- Splash before Android 12: the page colour with the sun, centred. The mark is a 240dp
     canvas whose sun is 160dp across, the same as the Flutter intro's first frame. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/splash_bg" />
    <item android:drawable="@drawable/splash_mark" android:gravity="center"
        android:width="240dp" android:height="240dp" />
</layer-list>
